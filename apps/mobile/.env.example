# Copy to .env.local and fill in your values from the Supabase dashboard.
# Both values are public-by-design (anon key is safe to ship in the client
# bundle; real security lives in RLS policies on the DB side). They must
# match the same Supabase project your PWA uses.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
