# Copia este archivo a .env.local y rellena con tus credenciales de Supabase.
# Las encuentras en: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL pública de la app (sin trailing slash). Vercel asigna esto automáticamente
# como VERCEL_URL pero para construir redirects de OAuth usamos esta.
# En producción ponla a tu URL de Vercel o dominio custom.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo si quieres correr scripts admin (ej. tests con datos sembrados).
# NO lo subas a git. NO se usa desde el cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Web Push (PWA notifications) ─────────────────────────────────────────────
# Genera el par con:  npx web-push generate-vapid-keys
# La PUBLIC se expone al browser (es seguro). La PRIVATE NO se sube a git.
# Para que las push lleguen necesitás también setear estas tres como secrets
# en Supabase Edge Functions (Dashboard > Edge Functions > Manage secrets).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@domirank.app

# ── Resend (transactional email) ────────────────────────────────────────────
# Required en prod para Club Pro invitations + ghost claim flow + notifications.
# Sin RESEND_API_KEY, sendEmail() es no-op (devuelve false con warning).
#
# Dominio: domirank.app debe estar verified en Resend dashboard:
#   https://resend.com/domains
# DNS records (MX, SPF, DKIM) deben estar configurados en el registrar.
#
# Para dev / testing rápido podés usar "onboarding@resend.dev" como remitente
# — Resend solo te deja enviar a tu propia cuenta verificada con ese sender.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="DomiRank <noreply@domirank.app>"
