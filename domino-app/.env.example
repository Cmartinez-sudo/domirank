# Copia este archivo a .env.local y rellena con tus credenciales de Supabase.
# Las encuentras en: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL pública de la app (sin trailing slash). Vercel asigna esto automáticamente
# como VERCEL_URL pero para construir redirects de OAuth usamos esta.
# En producción ponla a tu URL de Vercel o dominio custom.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo si quieres correr scripts admin (ej. tests con datos sembrados).
# NO lo subas a git. NO se usa desde el cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
